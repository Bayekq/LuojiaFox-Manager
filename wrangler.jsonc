{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "luojiafox-v21",
	"main": "worker/index.js",
	"compatibility_date": "2026-10-08",
	"workers_dev": true,
	"assets": {
		"directory": "./dist/",
		"binding": "ASSETS",
		"run_worker_first": [
			"/api/*",
			"/api"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "rm-command-db",
			"database_id": "ce516125-d335-4569-8112-3126e3896214",
			"migrations_dir": "migrations"
		},
		{
			"binding": "rm_command_db",
			"database_name": "rm-command-db",
			"database_id": "ce516125-d335-4569-8112-3126e3896214",
			"remote": true
		}
	]
}